# Copy to .env (git-ignored). Every value is an address or a name; none is a secret.
# BACKEND=memory runs the app with in-memory stand-ins (no Azure). BACKEND=azure uses DefaultAzureCredential:
# the managed identity inside Azure, your `az login` session on a laptop.
BACKEND=memory

# Required when BACKEND=azure (outputs of the Terraform environment: vault_url, storage_url).
VAULT_URL=https://kv-secretless-00000.vault.azure.net/
STORAGE_URL=https://stsecretless00000.blob.core.windows.net/

# The client id of the user-assigned identity. It names the identity and is not a secret. Leave empty on a laptop.
AZURE_CLIENT_ID=

UPLOAD_CONTAINER=uploads
SECRET_NAME=partner-api-key
MAX_UPLOAD_BYTES=5000000
LOG_LEVEL=INFO

# Rehearse step 5 offline: a comma list of blob, vault (BACKEND=memory only).
MEMORY_DENY=
